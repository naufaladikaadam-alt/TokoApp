<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.DaftarController"
            stylesheets="@styles/app.css">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label text="Daftar Produk Toko" styleClass="title"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label text="Tambah produk" styleClass="subtitle"/>
                        <Label text="Nama produk"/>
                        <TextField fx:id="namaField" promptText="Contoh: Nasi Goreng"/>
                        <Label text="Kategori"/>
                        <ComboBox fx:id="kategoriBox" maxWidth="Infinity"/>
                        <Label text="Harga (Rp)"/>
                        <TextField fx:id="hargaField" promptText="Contoh: 15000"/>
                        <Label text="Kode produk dibuat otomatis (PR001, PR002, ...)."
                               wrapText="true" styleClass="muted"/>
                        <Button text="Tambah Produk" onAction="#tambah"
                                styleClass="button-primary" maxWidth="Infinity"/>
                        <Label fx:id="pesanLabel" wrapText="true" styleClass="error"/>
                    </VBox>
                    <VBox spacing="12" styleClass="card">
                        <Label text="Cari produk" styleClass="subtitle"/>
                        <HBox spacing="10">
                            <TextField fx:id="cariField" promptText="Cari nama produk"
                                       onAction="#cari" HBox.hgrow="ALWAYS"/>
                            <Button text="Cari" onAction="#cari" styleClass="button-primary"/>
                            <Button text="Reset" onAction="#resetPencarian"/>
                        </HBox>
                        <TableView fx:id="tabel" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="kodeCol" text="Kode" prefWidth="100"/>
                                <TableColumn fx:id="namaCol" text="Nama Produk" prefWidth="280"/>
                                <TableColumn fx:id="kategoriCol" text="Kategori" prefWidth="140"/>
                                <TableColumn fx:id="hargaCol" text="Harga" prefWidth="160"/>
                            </columns>
                        </TableView>
                        <Button text="Lihat Detail" onAction="#detail"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
